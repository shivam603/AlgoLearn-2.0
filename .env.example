# AlgoLearn Environment Variables Configuration
# Copy this file to .env and adjust the values as needed.

# Application Port (Render automatically sets PORT in production)
PORT=3000

# MongoDB Atlas / Local Connection URI
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# If omitted or invalid, AlgoLearn gracefully falls back to in-memory history storage
MONGO_URI=mongodb://127.0.0.1:27017

# Database and Collection Names
MONGO_DB_NAME=sortingVisualizer
MONGO_COLLECTION=history

# Environment Mode (development / production)
NODE_ENV=development
